# ==========================================
# OmniMail — Environment Configuration
# Temporary Email SaaS by OmniBey
# ==========================================

# Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_DOMAIN=omnibey.com
NEXT_PUBLIC_MAIL_DOMAIN=mail.omnibey.com

# Supabase Credentials (Public & Service Role)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google OAuth (Supabase Auth Providers)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Telegram Admin Notification Bot
# 1. Create a bot with @BotFather to get the token
# 2. Start a chat with the bot and fetch your Chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_ADMIN_CHAT_ID=987654321

# Payment Configuration & Storage Retention
PAYMENT_PROOF_BUCKET=payment-proofs
REJECTED_SCREENSHOT_RETENTION_DAYS=7

# Default App Admin Email (for initial seed / elevated privileges)
ADMIN_DEFAULT_EMAIL=admin@omnibey.com
